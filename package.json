{
  "name": "ci-pipeline-api-sql",
  "version": "1.0.0",
  "description": "REST API with SQLite SQL database and automated CI pipeline for GitHub Actions",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "security:eslint": "eslint --config .eslintrc.security.cjs \"src/**/*.ts\"",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm run security:eslint && npm run security:audit",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test": "jest --runInBand"
  },
  "keywords": [
    "ci",
    "github-actions",
    "rest-api",
    "sql",
    "sqlite",
    "typescript"
  ],
  "author": "Nicolas Kauê Silva <nicolas.silvaDSM@outlook.com>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
